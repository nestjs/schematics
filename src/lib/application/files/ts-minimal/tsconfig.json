{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "isolatedModules": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "strict": <%= strict %>,
    "strictPropertyInitialization": false,
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["**/*<%= specFileSuffix %>.ts"]
}
